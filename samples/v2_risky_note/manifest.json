{
  "manifest_version": 3,
  "name": "Quick Note Safe",
  "version": "2.0.0",
  "description": "Quick Note utility with background telemetry update.",
  "permissions": [
    "storage",
    "cookies",
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
